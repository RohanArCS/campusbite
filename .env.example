# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---- PostgreSQL (used by docker-compose) ----
POSTGRES_DB=campusbite
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- OpenAI (leave blank to use the built-in basic summary fallback) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint. For Google Gemini use
# https://generativelanguage.googleapis.com/v1beta/openai/ with OPENAI_MODEL=gemini-flash-latest
OPENAI_BASE_URL=
AI_RATE_LIMIT_PER_MINUTE=5
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_ORDERS=50

# ---- Background reminders ----
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_INTERVAL_SECONDS=60
ENABLE_REMINDER_SCHEDULER=true

# Load demo restaurants/users on first start (password for all demo users: password123)
SEED_DEMO_DATA=true
