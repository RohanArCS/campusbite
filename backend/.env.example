# For running the backend WITHOUT Docker (uvicorn directly).
# Copy to backend/.env. When using docker-compose, use the root .env instead.

# SQLite for quick local dev; or e.g. postgresql+psycopg://user:pass@localhost:5432/campusbite
DATABASE_URL=sqlite:///./campusbite.db
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint. For Google Gemini use
# https://generativelanguage.googleapis.com/v1beta/openai/ with OPENAI_MODEL=gemini-flash-latest
OPENAI_BASE_URL=
AI_RATE_LIMIT_PER_MINUTE=5
AI_MAX_OUTPUT_TOKENS=2000
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_INTERVAL_SECONDS=60
SEED_DEMO_DATA=true
